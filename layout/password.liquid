<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  <link rel="icon" href="{{ 'himera-logo.png' | asset_url }}" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Metal+Mania&family=Anton&family=Archivo+Narrow:ital,wght@0,400;0,500;0,600;0,700;1,500&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div class="pw-wrap">
    <img src="{{ 'himera-logo.png' | asset_url }}" alt="{{ shop.name }}" width="96" height="96">
    <h1 class="w-bold">{{ shop.name | default: 'HIMERA' }}</h1>
    <p>Strefa jest zamknięta. Wejście tylko dla tych, którzy znają hasło.</p>

    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {% form 'storefront_password', class: 'pw-form' %}
      {%- if form.errors -%}
        <p class="field-note error">Złe hasło. Spróbuj ponownie.</p>
      {%- endif -%}
      <label for="pw" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Hasło</label>
      <input type="password" id="pw" name="password" placeholder="HASŁO" required>
      <button type="submit" class="btn-primary">WEJDŹ</button>
    {% endform %}

    {% form 'customer', class: 'pw-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="pw-email" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">E-mail</label>
      <input type="email" id="pw-email" name="contact[email]" placeholder="POWIADOM MNIE O PREMIERZE" required>
      <button type="submit" class="btn-primary">ZAPISZ SIĘ</button>
      {%- if form.posted_successfully? -%}
        <p class="field-note ok" style="width:100%;">Zapisano — bądź czujny.</p>
      {%- endif -%}
    {% endform %}
  </div>
</body>
</html>
