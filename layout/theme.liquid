<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>

  <link rel="icon" href="{{ 'himera-logo.png' | asset_url }}" type="image/png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Metal+Mania&family=Anton&family=Archivo+Narrow:ital,wght@0,400;0,500;0,600;0,700;1,500&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% style %}
    :root{
      --ink: {{ settings.color_ink | default: '#0a0a0b' }};
      --surface: {{ settings.color_surface | default: '#17171a' }};
      --bone: {{ settings.color_bone | default: '#ece9e2' }};
      --dim: {{ settings.color_dim | default: '#93908a' }};
      --line: {{ settings.color_line | default: '#2b2b30' }};
    }
  {% endstyle %}

  {{ content_for_header }}
</head>
<body data-reveal="{{ settings.enable_reveal_animations }}">


  <div class="grain" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"/></filter>
      <rect width="100%" height="100%" filter="url(#n)"/>
    </svg>
  </div>
  {%- if settings.enable_cursor_dot -%}
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
  {%- endif -%}

  {%- if template == 'index' -%}
  <div class="intro" id="intro" role="dialog" aria-label="Wejście HIMERA">
    <div class="smoke s1"></div>
    <div class="smoke s2"></div>
    <div class="smoke s3"></div>
    <div class="smoke s4"></div>

    <div class="drift-car-wrap" aria-hidden="true">
      <svg viewBox="0 0 640 220" xmlns="http://www.w3.org/2000/svg">
        <g fill="#ece9e2">
          <path d="M40,152 C40,152 52,114 88,98 C116,86 146,83 172,81 C183,56 204,41 234,39 C280,36 331,39 366,46 C401,53 431,63 456,79 C480,93 496,101 521,106 C556,111 592,121 601,141 C606,156 600,166 585,169 L562,169 C562,151 547,137 528,137 C509,137 494,151 494,169 L202,169 C202,151 187,137 168,137 C149,137 134,151 134,169 L72,169 C56,169 40,163 40,152 Z"/>
        </g>
        <path d="M196,81 C207,60 224,49 247,47 C282,44 322,46 352,52 C374,57 393,65 406,76 C406,76 342,80 282,80 C247,80 217,80 196,81 Z" fill="#0a0a0b"/>
        <circle cx="168" cy="169" r="35" fill="#0a0a0b" stroke="#ece9e2" stroke-width="6"/>
        <circle cx="528" cy="169" r="35" fill="#0a0a0b" stroke="#ece9e2" stroke-width="6"/>
        <circle cx="168" cy="169" r="14" fill="#ece9e2"/>
        <circle cx="528" cy="169" r="14" fill="#ece9e2"/>
      </svg>
    </div>
    <div class="driftsmoke d1"></div>
    <div class="driftsmoke d2"></div>
    <div class="driftsmoke d3"></div>
    <div class="driftsmoke d4"></div>
    <div class="driftsmoke d5"></div>

    <img class="intro-logo-img" src="{{ 'himera-logo.png' | asset_url }}" alt="" width="260" height="260">
    <h1 class="intro-word" data-text="{{ shop.name | default: 'HIMERA' }}">{{ shop.name | default: 'HIMERA' }}</h1>
    <button class="intro-skip" id="introSkip" type="button">POMIŃ ▸</button>
  </div>
  {%- endif -%}

  <div id="site"{% if template == 'index' %} aria-hidden="true"{% endif %}>
    {% section 'header' %}

    <div id="site-main">
      {{ content_for_layout }}
    </div>

    {% section 'footer' %}
  </div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_footer }}
</body>
</html>
