{%- comment -%}
  Showroom: products on glass panels in an arc, a metal ring of light above and a platform below.
  Switching (arrows, tabs, drag, swipe) slides the arc; the platform rises and swaps the title.
  Clicking the front panel (or the hint) picks the product: it slides left under the light and the details open on the right.
  While a product is picked the page scrolls only through its details (the rest of the page is hidden); only the arrows change it and "Wróć" goes back.
  Picking white turns the ring light white. The details describe the product in short points and show every photo of it.
{%- endcomment -%}
{%- liquid
  assign picks = section.blocks | where: 'type', 'product'
  assign total = 0
  for block in picks
    if block.settings.product != blank
      assign total = total | plus: 1
    endif
  endfor
  if total == 0
    assign source = collection.products
  endif
-%}
<section class="sr" data-sr aria-label="{{ collection.title | escape }}">
  <div class="sr__pin">
    <div class="sr__bg" aria-hidden="true"></div>
    <div class="sr__corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <div class="sr__hud sr__hud--l mono" aria-hidden="true">
      <span data-sr-code></span>
      <span><b data-sr-now>01</b> / <span data-sr-total>03</span></span>
    </div>
    <div class="sr__hud sr__hud--r mono" aria-hidden="true">
      <span>{{ section.settings.hud_1 }}</span>
      <span>{{ section.settings.hud_2 }}</span>
    </div>
    <button class="sr__arrow sr__arrow--l" type="button" data-sr-prev aria-label="Poprzedni">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="sr__arrow sr__arrow--r" type="button" data-sr-next aria-label="Następny">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
    </button>

    <div class="sr__plat sr__plat--top" aria-hidden="true" data-sr-top><i class="sr__rim"></i><i class="sr__leds"></i></div>
    <div class="sr__cone" aria-hidden="true"></div>

    <div class="sr__scene" data-sr-scene>
      <div class="sr__ring" data-sr-ring></div>
    </div>

    <div class="sr__plat sr__plat--bot" aria-hidden="true" data-sr-bot><i class="sr__leds"></i><i class="sr__rim"></i></div>

    <div class="sr__titles" aria-live="polite" data-sr-titles></div>

    <div class="sr__tabs mono" role="tablist" data-sr-tabs>
      <i class="sr__dot" aria-hidden="true" data-sr-dot></i>
    </div>
    <button class="sr__hint mono" type="button" data-sr-down><span>{{ section.settings.hint }}</span><i aria-hidden="true"></i></button>

  </div>

  {%- comment -%} one entry per product: data for the ring + the detail panel {%- endcomment -%}
  <div class="sr__details" data-sr-details>
    {%- assign n = 0 -%}
    {%- for block in picks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank -%}
        {% render 'sr-item', p: p, idx: n, total: total, label: block.settings.label, heading: block.settings.heading, points: block.settings.slogans %}
        {%- assign n = n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if total == 0 -%}
      {%- for p in source limit: 3 -%}
        {% render 'sr-item', p: p, idx: forloop.index0, total: source.size, label: '', heading: '', points: '' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
  <button class="sr__back mono" type="button" data-sr-back tabindex="-1">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
    <span>{{ section.settings.back }}</span>
  </button>
</section>
{% schema %}
{
  "name": "Showroom produktów",
  "settings": [
    { "type": "text", "id": "hud_1", "label": "Napis w prawym rogu (1)", "default": "Darmowa dostawa" },
    { "type": "text", "id": "hud_2", "label": "Napis w prawym rogu (2)", "default": "od 70 zł" },
    { "type": "text", "id": "hint", "label": "Podpowiedź pod showroomem", "default": "Kliknij produkt, aby go wybrać" },
    { "type": "text", "id": "back", "label": "Przycisk powrotu", "default": "Wróć do showroomu" }
  ],
  "blocks": [
    { "type": "product", "name": "Produkt", "settings": [
      { "type": "product", "id": "product", "label": "Produkt" },
      { "type": "text", "id": "label", "label": "Nazwa w zakładce", "default": "Kominiarka" },
      { "type": "text", "id": "heading", "label": "Duży napis (puste: nazwa produktu)" },
      { "type": "text", "id": "slogans", "label": "Opis w hasłach (oddziel |; puste: opis produktu)" }
    ] }
  ],
  "max_blocks": 6
}
{% endschema %}
