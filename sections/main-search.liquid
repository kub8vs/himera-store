<section class="pg wrap">
  <h1 class="page-h">{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" class="join__field srch" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="btn btn--bone" type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}<p class="mono">{{ 'search.empty' | t }}</p>{%- else -%}
    <div class="grid">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}{%- endfor -%}</div>
    {%- endif -%}
  {%- endif -%}
</section>
{% schema %}{ "name": "Wyszukiwarka" }{% endschema %}
