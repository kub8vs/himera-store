{%- comment -%} "Cała kolekcja i darmowa dostawa": every product in a floating strip, the free-delivery threshold and one button. {%- endcomment -%}
{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
  assign url = section.settings.cta_url | default: routes.all_products_collection_url
-%}
<section class="band" id="{{ section.settings.anchor | default: 'kolekcja' }}" data-band>
  <div class="wrap band__head">
    <div>
      <span class="mono band__kicker" data-reveal>{{ section.settings.kicker }}</span>
      <h2 class="band__h" data-reveal>{{ section.settings.heading }}</h2>
    </div>
    <a class="btn btn--bone" href="{{ url }}" data-reveal>{{ section.settings.cta_label }}{% render 'icon-arrow' %}</a>
  </div>

  <div class="band__strip">
    {%- for product in col.products limit: section.settings.limit -%}
      {%- assign show = product.metafields.custom.showcase_image.value | default: product.featured_image -%}
      <a class="band__item{% unless product.available %} is-out{% endunless %}" href="{{ product.url }}" style="--n: {{ forloop.index0 }}">
        <span class="band__media">{{ show | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title, width: 600, height: 600 }}</span>
        <span class="band__name">{{ product.metafields.custom.short_title.value | default: product.title }}</span>
        <span class="mono band__price">{{ product.price | money }}{% unless product.available %} · {{ 'products.sold_out' | t }}{% endunless %}</span>
      </a>
    {%- endfor -%}
  </div>

  <div class="wrap">
    <div class="band__ship" data-reveal>
      <span class="band__truck" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17.5" cy="17" r="1.6"/></svg>
      </span>
      <div class="band__shiptext">
        <strong>{{ section.settings.ship_title }}</strong>
        <span>{{ section.settings.ship_text }}</span>
      </div>
      <span class="band__bar" aria-hidden="true"><i></i><b class="mono">{{ section.settings.threshold }} zł</b></span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Cała kolekcja + dostawa",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Kotwica (#)", "default": "kolekcja" },
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "WSZYSTKO W JEDNYM MIEJSCU" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Cała kolekcja" },
    { "type": "collection", "id": "collection", "label": "Kolekcja", "info": "Puste: wszystkie produkty." },
    { "type": "range", "id": "limit", "label": "Ile produktów w pasku", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "cta_label", "label": "Przycisk", "default": "Zobacz całą kolekcję" },
    { "type": "url", "id": "cta_url", "label": "Link przycisku" },
    { "type": "text", "id": "ship_title", "label": "Dostawa: tytuł", "default": "Darmowa dostawa od 70 zł" },
    { "type": "text", "id": "ship_text", "label": "Dostawa: tekst", "default": "Flaga i naklejka i już nie płacisz za wysyłkę." },
    { "type": "number", "id": "threshold", "label": "Próg darmowej dostawy (zł)", "default": 70 }
  ],
  "presets": [{ "name": "Cała kolekcja + dostawa" }]
}
{% endschema %}
