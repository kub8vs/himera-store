{%- liquid
  assign img = product.metafields.custom.showcase_image.value | default: product.featured_image
  assign code = product.metafields.custom.code.value | default: product.type
  assign variant = product.selected_or_first_available_variant
-%}
<section class="pdp" data-pdp>
  <div class="pdp__stage" aria-hidden="true">
    <div class="show__room"><i class="show__wall"></i><i class="show__floor"></i></div>
    <div class="show__ring show__ring--sm"><i class="show__disc"></i><i class="show__led show__led--1"></i><i class="show__led show__led--2"></i><i class="show__led show__led--3"></i><i class="show__scan"></i></div>
    <div class="show__cone"></div>
    {%- capture src -%}{{ img | image_url: width: 1400 }}{%- endcapture -%}
    <div class="show__item is-on pdp__item" style="--src: url('{{ src }}')">
      <img src="{{ src }}" alt="" width="1200" height="1200" fetchpriority="high">
      <i class="show__lit"></i>
    </div>
    <div class="show__pool"><span class="show__mirror is-on">{{ code }}</span></div>
  </div>

  <div class="pdp__info">
    <nav class="pdp__crumbs mono" aria-label="Okruszki"><a href="{{ routes.root_url }}">HIMERA</a> / <a href="{{ routes.all_products_collection_url }}">{{ 'products.all' | t }}</a></nav>
    <span class="mono pdp__code">{{ code }}</span>
    <h1 class="pdp__title">{{ product.title }}</h1>
    {% render 'price', product: product %}
    <div class="pdp__desc rte">{{ product.description }}</div>

    {%- form 'product', product, class: 'pdp__form', data-type: 'add' -%}
      {%- unless product.has_only_default_variant -%}
        <label class="mono pdp__label" for="pdp-variant">{{ product.options.first }}</label>
        <select id="pdp-variant" name="id" class="pdp__select">
          {%- for v in product.variants -%}<option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money }}</option>{%- endfor -%}
        </select>
      {%- else -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
      {%- endunless -%}
      <div class="pdp__buy">
        <div class="qty" data-qty>
          <button type="button" data-qty-minus aria-label="Mniej">−</button>
          <input type="number" name="quantity" value="1" min="1" max="20" aria-label="Ilość">
          <button type="button" data-qty-plus aria-label="Więcej">+</button>
        </div>
        {%- if product.available -%}
          <button class="btn btn--bone pdp__add" type="submit" data-add data-title="{{ product.title | escape }}" data-price="{{ product.price }}" data-url="{{ product.url }}" data-img="{{ product.featured_image | image_url: width: 300 }}">{{ 'products.add_to_cart' | t }}{% render 'icon-arrow' %}</button>
        {%- else -%}
          <span class="btn btn--off pdp__add" aria-disabled="true">{{ 'products.sold_out' | t }}</span>
        {%- endif -%}
      </div>
    {%- endform -%}
    {%- unless product.available -%}
      <a class="pdp__notify mono" href="{{ routes.root_url }}#dolacz">{{ 'products.notify' | t }} <span aria-hidden="true">↗</span></a>
    {%- endunless -%}

    <ul class="pdp__facts mono">
      <li>{{ 'general.free_shipping' | t }}</li>
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
    </ul>
  </div>
</section>

{%- if section.settings.show_more -%}
<section class="more wrap">
  <h2 class="more__h">{{ section.settings.more_heading }}</h2>
  <div class="grid grid--4">
    {%- assign shown = 0 -%}
    {%- for p in collections.all.products -%}
      {%- if p.handle != product.handle and shown < 4 -%}
        {% render 'product-card', product: p %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Produkt",
  "settings": [
    { "type": "checkbox", "id": "show_more", "label": "Pokaż inne produkty", "default": true },
    { "type": "text", "id": "more_heading", "label": "Nagłówek innych produktów", "default": "Reszta dropu" }
  ],
  "blocks": [
    { "type": "fact", "name": "Informacja", "settings": [{ "type": "text", "id": "text", "label": "Tekst", "default": "Wysyłka w 1–3 dni robocze" }] }
  ]
}
{% endschema %}
