{%- comment -%} Home "Produkty": a small preview of the showroom (ring of light, floating products) with one frosted-glass button into it. {%- endcomment -%}
{%- liquid
  assign url = section.settings.link | default: routes.all_products_collection_url
-%}
<section class="gate" id="{{ section.settings.anchor | default: 'produkty' }}" data-gate>
  <div class="gate__glow" aria-hidden="true"></div>
  <div class="wrap gate__head reveal">
    <span class="mono gate__kicker">{{ section.settings.kicker }}</span>
    <h2 class="gate__h">{{ section.settings.heading | replace: '|', '<br>' }}</h2>
    {%- if section.settings.text != blank -%}<p class="gate__text">{{ section.settings.text }}</p>{%- endif -%}
  </div>

  <a class="gate__stage" href="{{ url }}" data-gate-stage>
    <span class="gate__room" aria-hidden="true">
      <span class="gate__plat"><i class="sr__rim"></i><i class="sr__leds"></i></span>
      <span class="gate__cone"></span>
      <span class="gate__fan">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- assign img = p.metafields.custom.showcase_image.value | default: p.featured_image -%}
            <span class="gate__card" style="--n:{{ forloop.index0 }};--of:{{ forloop.length }}" {{ block.shopify_attributes }}>
              <span class="gate__float">{{ img | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </span>
      <span class="gate__floor"></span>
    </span>
    <span class="gate__btn mono">{{ section.settings.button_label }} {% render 'icon-arrow' %}</span>
  </a>

  {%- if section.settings.note != blank -%}
    <p class="mono gate__note reveal"><i></i>{{ section.settings.note }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Wejście do sklepu",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Kotwica", "default": "produkty" },
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "Produkty" },
    { "type": "text", "id": "heading", "label": "Nagłówek (| = nowa linia)", "default": "Stań się|częścią Himery." },
    { "type": "text", "id": "text", "label": "Podtytuł", "default": "Wybierz swój produkt" },
    { "type": "text", "id": "button_label", "label": "Przycisk", "default": "Zobacz produkty" },
    { "type": "url", "id": "link", "label": "Link (domyślnie wszystkie produkty)" },
    { "type": "text", "id": "note", "label": "Dopisek pod przyciskiem", "default": "Darmowa dostawa od 70 zł" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produkt w tle",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "label", "label": "Podpis" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Wejście do sklepu" }]
}
{% endschema %}
