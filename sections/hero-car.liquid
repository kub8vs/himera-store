<section class="hero" data-hero aria-label="{{ section.settings.heading | escape }}">
  <div class="hero__studio" aria-hidden="true">
    <div class="hero__wall"></div>
    <div class="hero__wallword">{{ section.settings.wall_text }}</div>
    <div class="hero__floor"></div>
    <div class="hero__haze"></div>
  </div>
  <div class="hero__word" aria-hidden="true"><span>HIMERA</span><span class="hero__word-lit">HIMERA</span></div>

  <div class="hero__car" data-car>
    <div class="hero__drive" data-drive>
      <div class="hero__shadow"></div>
      <img class="hero__refl" src="{{ 'himera-car.webp' | asset_url }}" alt="" width="1968" height="633" loading="eager">
      <div class="hero__body">
        <img class="hero__img" src="{{ 'himera-car.webp' | asset_url }}" alt="{{ section.settings.car_alt | escape }}" width="1968" height="633" fetchpriority="high">
        <img class="hero__wheel hero__wheel--f" src="{{ 'himera-wheel-f.webp' | asset_url }}" alt="" width="240" height="240">
        <img class="hero__wheel hero__wheel--r" src="{{ 'himera-wheel-r.webp' | asset_url }}" alt="" width="240" height="240">
        <div class="hero__sheen" style="--mask: url('{{ 'himera-car.webp' | asset_url }}')"></div>
        <i class="hero__tail" data-tail></i>
        <i class="hero__head"></i>
      </div>
    </div>
  </div>

  <div class="hero__copy wrap">
    <div class="hero__left">
      <span class="mono hero__kicker">{{ section.settings.kicker }}</span>
      <h1 class="hero__h">{{ section.settings.heading }}</h1>
    </div>
    <div class="hero__right">
      <p>{{ section.settings.text }}</p>
      <div class="btns">
        <a class="btn btn--bone" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="btn btn--line" href="#dolacz">{{ section.settings.cta2_label }}</a>
      </div>
    </div>
  </div>
  <a class="hero__cue mono" href="#dolacz"><span>{{ section.settings.cue }}</span><i></i></a>
</section>
{% schema %}
{
  "name": "Auto Himery",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "BMW M3 · OKLEINA HIMERY" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Jesteśmy ruchem." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Nocne spoty, auta i ludzie, którzy trzymają się razem. Każdy drop to krótka seria. Kiedy się kończy, nie wraca w tej samej formie." },
    { "type": "text", "id": "cta_label", "label": "Przycisk 1", "default": "Wejdź do sklepu" },
    { "type": "url", "id": "cta_url", "label": "Link przycisku 1" },
    { "type": "text", "id": "cta2_label", "label": "Przycisk 2", "default": "Stań się częścią" },
    { "type": "text", "id": "car_alt", "label": "Opis auta", "default": "Czarne BMW M3 z okleiną Himery" },
    { "type": "text", "id": "wall_text", "label": "Ukryty napis na ścianie", "default": "JESTEŚMY RUCHEM A TY JEGO CZĘŚCIĄ" },
    { "type": "text", "id": "cue", "label": "Podpowiedź przewijania", "default": "Przewiń" }
  ],
  "presets": [{ "name": "Auto Himery" }]
}
{% endschema %}
