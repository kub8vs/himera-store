{%- comment -%} "Stań się częścią HIMERY": heading on top, a C63 AMG, an RS7 and Himera's M3 rolling in and meeting in the middle, three CTA cards below. {%- endcomment -%}
<section class="part part--convoy" id="{{ section.settings.anchor | default: 'ruch' }}" data-hero>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">{%- for n in (0..2) -%}<filter id="hmr-blur-{{ n }}" x="-10%" y="0" width="120%" height="100%"><feGaussianBlur data-blur stdDeviation="0 0"/></filter>{%- endfor -%}</svg>
  <div class="part__wallword" aria-hidden="true">{{ section.settings.wall_text }}</div>

  <div class="part__top">
    <div class="part__copy wrap">
      <span class="mono part__kicker" data-reveal>{{ section.settings.kicker }}</span>
      <h2 class="part__title" data-reveal>
        {%- assign lines = section.settings.heading | split: '|' -%}
        {%- for line in lines -%}<span class="part__tl"><span>{{ line | strip }}</span></span>{%- endfor -%}
      </h2>
      <p class="part__text" data-reveal>{{ section.settings.text }}</p>
      <div class="btns" data-reveal>
        <a class="btn btn--bone" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}{% render 'icon-arrow' %}</a>
      </div>
    </div>

    <div class="part__stage">
      <div class="convoy" data-convoy>
        <div class="hero__floor" aria-hidden="true"></div>
        {%- comment -%} a Mercedes (left) and an Audi (right) further back meet nose to nose, Himera's own car rolls in front of them {%- endcomment -%}
        {%- liquid
          assign cars = 'himera-car-merc.webp,himera-car-audi.webp,himera-car.webp' | split: ','
          assign sides = 'left,right,right' | split: ','
          assign kinds = 'back back--l,back back--r,front' | split: ','
          assign delays = '0,160,700' | split: ','
        -%}
        {%- for car in cars -%}
          {%- assign i = forloop.index0 -%}
          <div class="hero__car hero__car--{{ kinds[i] | split: ' ' | last }}{% if kinds[i] contains 'back' %} hero__car--back{% endif %}" data-car data-from="{{ sides[i] }}" data-delay="{{ delays[i] }}">
            <div class="hero__drive" data-drive>
              <div class="hero__shadow"></div>
              <img class="hero__refl" src="{{ car | asset_url }}" alt="" width="1968" height="633" loading="lazy">
              <div class="hero__body" data-body>
                <img class="hero__img" src="{{ car | asset_url }}" alt="{% if forloop.last %}{{ section.settings.car_alt | escape }}{% endif %}" width="1968" height="633" loading="lazy">
                <img class="hero__wheel hero__wheel--f" src="{{ 'himera-wheel-f.webp' | asset_url }}" alt="" width="240" height="240" data-wheel>
                <img class="hero__wheel hero__wheel--r" src="{{ 'himera-wheel-r.webp' | asset_url }}" alt="" width="240" height="240" data-wheel>
                <div class="hero__sheen" style="--mask: url('{{ car | asset_url }}')"></div>
                <i class="hero__tail"{% if forloop.last %} data-tail{% endif %}></i>
                <i class="hero__head"></i>
              </div>
            </div>
            <i class="hero__beam" aria-hidden="true"></i>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="part__cards wrap">
    {%- for block in section.blocks -%}
      {%- liquid
        assign url = block.settings.url
        if url == blank
          assign url = routes.root_url
        endif
      -%}
      <a class="cta" href="{{ url }}" data-tilt data-reveal style="--d: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}{% if url contains 'http' %} target="_blank" rel="noopener"{% endif %}>
        <span class="cta__glare" aria-hidden="true"></span>
        <span class="cta__num" aria-hidden="true">0{{ forloop.index }}</span>
        <span class="mono cta__kicker">{{ block.settings.kicker }}</span>
        <h3 class="cta__title">{{ block.settings.title }}</h3>
        <p class="cta__text">{{ block.settings.text }}</p>
        <span class="cta__go mono">{{ block.settings.label }}{% render 'icon-arrow' %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Stań się częścią + auto",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Kotwica (#)", "default": "ruch" },
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "HMR · EKIPA" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "info": "Znak | łamie linię.", "default": "Stań się|częścią|HIMERY." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Nocne spoty, auta i ludzie, którzy trzymają się razem. Każdy drop to krótka seria. Kiedy się kończy, nie wraca w tej samej formie." },
    { "type": "text", "id": "cta_label", "label": "Przycisk", "default": "Zobacz produkty" },
    { "type": "url", "id": "cta_url", "label": "Link przycisku" },
    { "type": "text", "id": "car_alt", "label": "Opis auta", "default": "Mercedes-AMG C63, Audi RS7 i z przodu czarne M3 Himery" },
    { "type": "text", "id": "wall_text", "label": "Ukryty napis w tle", "default": "JESTEŚMY RUCHEM A TY JEGO CZĘŚCIĄ" }
  ],
  "blocks": [
    { "type": "cta", "name": "Karta CTA", "settings": [
      { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "HIMERA" },
      { "type": "text", "id": "title", "label": "Tytuł", "default": "Tytuł" },
      { "type": "textarea", "id": "text", "label": "Tekst", "default": "Opis." },
      { "type": "text", "id": "label", "label": "Tekst linku", "default": "Zobacz" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Stań się częścią + auto", "blocks": [{ "type": "cta" }, { "type": "cta" }, { "type": "cta" }] }]
}
{% endschema %}
