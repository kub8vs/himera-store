<article class="pg wrap">
  <span class="mono">{{ article.published_at | date: '%d.%m.%Y' }}</span>
  <h1 class="page-h">{{ article.title }}</h1>
  {%- if article.image -%}{{ article.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'pg__img' }}{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>
{% schema %}{ "name": "Artykuł" }{% endschema %}
