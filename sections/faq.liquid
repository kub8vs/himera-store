<section class="faq wrap" id="faq">
  <div class="faq__head">
    <span class="mono faq__kicker">{{ section.settings.kicker }}</span>
    <h1 class="page-h">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="faq__lead">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="faq__item" {{ block.shopify_attributes }}>
        <summary><span class="mono">0{{ forloop.index }}</span><span class="faq__q">{{ block.settings.question }}</span>{% render 'icon', name: 'plus' %}</summary>
        <div class="faq__a rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "PYTANIA" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "FAQ" },
    { "type": "textarea", "id": "text", "label": "Wstęp" }
  ],
  "blocks": [
    { "type": "q", "name": "Pytanie", "settings": [
      { "type": "text", "id": "question", "label": "Pytanie", "default": "Pytanie?" },
      { "type": "richtext", "id": "answer", "label": "Odpowiedź", "default": "<p>Odpowiedź.</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "q" }, { "type": "q" }] }]
}
{% endschema %}
