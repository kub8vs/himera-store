{%- liquid
  if section.settings.image
    assign portrait = section.settings.image | image_url: width: 1600
  else
    assign portrait = 'himera-portret.webp' | asset_url
  endif
  assign word = section.settings.word | default: 'HIMERA' | upcase
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="ph" data-ph aria-label="{{ shop.name }}">
  <h1 class="visually-hidden">{{ shop.name }}: {{ section.settings.line }}</h1>
  <div class="ph__glow" aria-hidden="true"></div>
  <div class="ph__grid" aria-hidden="true"></div>

  <div class="ph__stage" aria-hidden="true">
    <div class="ph__word" data-ph-word>
      <span class="ph__fill" data-word="{{ word }}">{{ word }}</span>
      <span class="ph__gl ph__gl--a">{{ word }}</span><span class="ph__gl ph__gl--b">{{ word }}</span>
    </div>
  </div>

  {%- comment -%} rising smoke across the whole width, drawn on a canvas {%- endcomment -%}
  <canvas class="ph__smoke" data-ph-smoke aria-hidden="true"></canvas>

  <div class="ph__hero" data-ph-hero>
    {%- comment -%} HUD ring behind the head: ticks, a scanning arc and the motto running around {%- endcomment -%}
    <div class="ph__ring" data-ph-ring aria-hidden="true">
      <svg viewBox="0 0 400 400" fill="none">
        <defs><path id="ph-ring-path" d="M200 200 m-162 0 a162 162 0 1 1 324 0 a162 162 0 1 1 -324 0"/></defs>
        <g class="ph__r ph__r--outer">
          <circle cx="200" cy="200" r="192" class="ph__r-line"/>
          <circle cx="200" cy="200" r="185" class="ph__r-ticks"/>
          <circle cx="200" cy="200" r="185" class="ph__r-major"/>
        </g>
        <g class="ph__r ph__r--text">
          <text class="ph__r-text"><textPath href="#ph-ring-path" textLength="1015" lengthAdjust="spacing">{{ section.settings.ring_text | default: 'HIMERA • JESTEŚMY RUCHEM • A TY JEGO CZĘŚCIĄ •' | upcase }}</textPath></text>
        </g>
        <g class="ph__r ph__r--arc">
          <circle cx="200" cy="200" r="140" class="ph__r-arc"/>
        </g>
        <g class="ph__r ph__r--orbit">
          <circle cx="200" cy="8" r="3.2" class="ph__r-dot"/>
        </g>
        <g class="ph__r-cross">
          <path d="M200 0v14M200 386v14M0 200h14M386 200h14"/>
        </g>
      </svg>
    </div>
    <img class="ph__portrait" src="{{ portrait }}" alt="{{ section.settings.alt | escape }}" width="1483" height="1843" fetchpriority="high">
  </div>

  {%- if section.settings.show_products -%}
    <div class="ph__floats">
      {%- for product in col.products limit: section.settings.limit -%}
        {%- assign img = product.metafields.custom.showcase_image.value | default: product.featured_image -%}
        <a class="ph__float ph__float--{{ forloop.index }}" href="{{ product.url }}" data-ph-float data-depth="{% cycle '1.2', '-0.9', '0.8', '-1.3', '0.6', '-0.6' %}" style="--n: {{ forloop.index0 }}">
          <span class="ph__in">
            <span class="ph__bob">
              {{ img | image_url: width: 600 | image_tag: alt: product.title, width: 600, height: 600, loading: 'eager' }}
              <span class="ph__tag mono">{{ product.metafields.custom.short_title.value | default: product.title }} · {{ product.price | money_without_trailing_zeros }}</span>
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="ph__fog" aria-hidden="true"></div>
  <a class="ph__cue mono" href="#ruch" aria-label="{{ section.settings.cue }}"><span>{{ section.settings.cue }}</span><i></i></a>
  <span class="ph__clock mono" aria-hidden="true" data-ph-clock></span>
</section>
{% schema %}
{
  "name": "Intro HIMERA",
  "settings": [
    { "type": "text", "id": "word", "label": "Napis", "default": "HIMERA" },
    { "type": "image_picker", "id": "image", "label": "Zdjęcie na pierwszym planie", "info": "Wycięte, przezroczyste tło. Domyślnie: zdjęcie w kominiarce z motywu." },
    { "type": "text", "id": "alt", "label": "Opis zdjęcia", "default": "Himera w kominiarce z logo" },
    { "type": "text", "id": "ring_text", "label": "Napis krążący za głową", "default": "HIMERA • JESTEŚMY RUCHEM • A TY JEGO CZĘŚCIĄ •" },
    { "type": "checkbox", "id": "show_products", "label": "Latające produkty", "default": true },
    { "type": "collection", "id": "collection", "label": "Które produkty latają", "info": "Najlepiej wyglądają zdjęcia z pola custom.showcase_image (przezroczyste tło)." },
    { "type": "range", "id": "limit", "label": "Ile produktów lata", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "text", "id": "line", "label": "Hasło (dla wyszukiwarek i czytników)", "default": "Jesteśmy ruchem, a ty jego częścią." },
    { "type": "text", "id": "cue", "label": "Podpowiedź przewijania", "default": "Przewiń" }
  ],
  "presets": [{ "name": "Intro HIMERA" }]
}
{% endschema %}
