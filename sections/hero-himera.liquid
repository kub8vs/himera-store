{%- liquid
  if section.settings.image
    assign portrait = section.settings.image | image_url: width: 1600
  else
    assign portrait = 'himera-portret.webp' | asset_url
  endif
  assign word = section.settings.word | default: 'HIMERA' | upcase
-%}
<section class="ph" data-ph aria-label="{{ shop.name }}">
  <h1 class="visually-hidden">{{ shop.name }}: {{ section.settings.line }}</h1>
  <div class="ph__glow" aria-hidden="true"></div>
  <div class="ph__grid" aria-hidden="true"></div>

  <div class="ph__stage" aria-hidden="true">
    <div class="ph__word" data-ph-word>
      <span class="ph__fill" data-word="{{ word }}">{{ word }}</span>
    </div>
  </div>

  <div class="ph__hero" data-ph-hero>
    <img class="ph__portrait" src="{{ portrait }}" alt="{{ section.settings.alt | escape }}" width="1483" height="1843" fetchpriority="high">
    <i class="ph__eye" style="left: 37.4%; top: 43.2%" aria-hidden="true"></i><i class="ph__eye" style="left: 58.4%; top: 42.6%" aria-hidden="true"></i>
  </div>

  <a class="ph__cue mono" href="#ruch" aria-label="{{ section.settings.cue }}"><span>{{ section.settings.cue }}</span><i></i></a>
  <span class="ph__clock mono" aria-hidden="true" data-ph-clock></span>
</section>
{% schema %}
{
  "name": "Intro HIMERA",
  "settings": [
    { "type": "text", "id": "word", "label": "Napis", "default": "HIMERA" },
    { "type": "image_picker", "id": "image", "label": "Zdjęcie na pierwszym planie", "info": "Wycięte, przezroczyste tło. Domyślnie: zdjęcie w kominiarce z motywu." },
    { "type": "text", "id": "alt", "label": "Opis zdjęcia", "default": "Himera w kominiarce z logo" },
    { "type": "text", "id": "line", "label": "Hasło (dla wyszukiwarek i czytników)", "default": "Jesteśmy ruchem, a ty jego częścią." },
    { "type": "text", "id": "cue", "label": "Podpowiedź przewijania", "default": "Przewiń" }
  ],
  "presets": [{ "name": "Intro HIMERA" }]
}
{% endschema %}
