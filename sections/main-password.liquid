<section class="pw">
  <img src="{{ 'himera-logo.webp' | asset_url }}" alt="{{ shop.name }}" width="140" height="116">
  <h1 class="page-h">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'join__field' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password">
    {%- if form.posted_successfully? -%}<p class="mono">{{ 'newsletter.success' | t }}</p>{%- else -%}
    <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.label' | t }}">
    <button class="btn btn--blood" type="submit">{{ 'newsletter.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}
  <details class="pw__login mono"><summary>Wejście dla właściciela</summary>
    {%- form 'storefront_password' -%}
      <input type="password" name="password" placeholder="Hasło" aria-label="Hasło"><button class="btn btn--line" type="submit">Wejdź</button>
    {%- endform -%}
  </details>
</section>
{% schema %}{ "name": "Hasło", "settings": [{ "type": "text", "id": "heading", "label": "Nagłówek", "default": "Drop wkrótce." }] }{% endschema %}
