{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="feat" data-feat>
  <div class="wrap feat__head">
    <div>
      <span class="mono feat__kicker">{{ section.settings.kicker }}</span>
      <h2 class="feat__h">{{ section.settings.heading }}</h2>
    </div>
    <a class="btn btn--line" href="{{ routes.all_products_collection_url }}">{{ 'products.all' | t }}{% render 'icon-arrow' %}</a>
  </div>
  <div class="feat__rail" data-feat-rail>
    {%- for product in col.products limit: section.settings.limit -%}
      <a class="feat__item{% unless product.available %} is-out{% endunless %}" href="{{ product.url }}" style="--n: {{ forloop.index0 }}">
        <span class="feat__rank">{{ forloop.index | prepend: '0' }}</span>
        <span class="feat__media">
          {%- assign show = product.metafields.custom.showcase_image.value | default: product.featured_image -%}
          {{ show | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title, width: 900, height: 900 }}
        </span>
        <span class="feat__meta">
          <span class="mono">{{ product.metafields.custom.code.value | default: product.type }}</span>
          <span class="feat__title">{{ product.title }}</span>
          {% render 'price', product: product %}
          {%- unless product.available -%}<span class="mono feat__out">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Top produkty",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "NAJCZĘŚCIEJ WYBIERANE" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Top 3 Himery" },
    { "type": "collection", "id": "collection", "label": "Kolekcja" },
    { "type": "range", "id": "limit", "label": "Liczba produktów", "min": 2, "max": 8, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Top produkty" }]
}
{% endschema %}
