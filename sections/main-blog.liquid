<section class="pg wrap">
  <h1 class="page-h">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="cols">
      {%- for article in blog.articles -%}<li><a href="{{ article.url }}"><span class="mono">{{ article.published_at | date: '%d.%m.%Y' }}</span>{{ article.title }}</a></li>{%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<nav class="pager mono">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
