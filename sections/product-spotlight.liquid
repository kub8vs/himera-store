{%- comment -%} "Produkty": the sliding showroom, below it the picked product with its description and the buy form. {%- endcomment -%}
<section class="spot" id="{{ section.settings.anchor | default: 'produkty' }}" data-show>
  <div class="spot__glow" aria-hidden="true"></div>
  <div class="wrap spot__head">
    <span class="mono spot__kicker" data-reveal>{{ section.settings.kicker }}</span>
    <h2 class="spot__h" data-reveal>{{ section.settings.heading }}</h2>
  </div>

  <div class="spot__room show__pin">
    <div class="show__room" aria-hidden="true"><i class="show__wall"></i><i class="show__floor"></i></div>
    <div class="show__ring" aria-hidden="true"><i class="show__disc"></i><i class="show__led show__led--1"></i><i class="show__led show__led--2"></i><i class="show__led show__led--3"></i><i class="show__scan"></i></div>
    <div class="show__cone" aria-hidden="true"></div>
    <div class="show__dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="show__stage">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- assign img = p.metafields.custom.showcase_image.value | default: p.featured_image -%}
          {%- capture src -%}{{ img | image_url: width: 1400 }}{%- endcapture -%}
          <a class="show__item" href="{{ p.url }}" data-show-item="{{ forloop.index0 }}" style="--src: url('{{ src }}'); --i: {{ forloop.index0 }}" tabindex="-1" aria-hidden="true" draggable="false">
            <span class="show__float"><img src="{{ src }}" alt="{{ p.title | escape }}" width="1200" height="1200" draggable="false" loading="lazy"><i class="show__lit"></i></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="show__pool" aria-hidden="true">
      {%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}<span class="show__mirror" data-show-mirror="{{ forloop.index0 }}">{{ p.metafields.custom.code.value | default: block.settings.label }}</span>{%- endif -%}{%- endfor -%}
    </div>
    <button class="show__arrow spot__arrow spot__arrow--l" type="button" data-show-prev aria-label="Poprzedni">{% render 'icon-arrow', dir: 'left' %}</button>
    <button class="show__arrow spot__arrow spot__arrow--r" type="button" data-show-next aria-label="Następny">{% render 'icon-arrow' %}</button>
  </div>

  <div class="wrap spot__panels">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank -%}
        {%- liquid
          assign code = p.metafields.custom.code.value | default: p.type
          assign variant = p.selected_or_first_available_variant
        -%}
        <article class="spot__panel{% if forloop.first %} is-on{% endif %}" id="spot-{{ block.id }}" role="tabpanel" data-show-panel="{{ forloop.index0 }}">
          <div class="spot__info">
            <span class="mono spot__code">{{ code }}</span>
            <h3 class="spot__title">{{ p.title }}</h3>
            {% render 'price', product: p %}
            <div class="spot__desc rte">{{ p.description }}</div>

            {%- form 'product', p, class: 'spot__form', data-type: 'add' -%}
              {%- unless p.has_only_default_variant -%}
                <label class="mono spot__label" for="spot-var-{{ block.id }}">{{ p.options.first }}</label>
                <select id="spot-var-{{ block.id }}" name="id" class="pdp__select">
                  {%- for v in p.variants -%}<option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money }}</option>{%- endfor -%}
                </select>
              {%- else -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
              {%- endunless -%}
              <input type="hidden" name="quantity" value="1">
              <div class="spot__buy">
                {%- if p.available -%}
                  <button class="btn btn--bone" type="submit" data-add data-title="{{ p.title | escape }}" data-price="{{ p.price }}" data-url="{{ p.url }}" data-img="{{ p.featured_image | image_url: width: 300 }}">{{ 'products.add_to_cart' | t }}{% render 'icon-arrow' %}</button>
                {%- else -%}
                  <span class="btn btn--off" aria-disabled="true">{{ 'products.sold_out' | t }}</span>
                {%- endif -%}
                <a class="btn btn--line" href="{{ p.url }}">{{ section.settings.more_label }}{% render 'icon-arrow' %}</a>
              </div>
            {%- endform -%}
            {%- unless p.available -%}
              <a class="spot__notify mono" href="#dolacz">{{ 'products.notify' | t }} <span aria-hidden="true">↗</span></a>
            {%- endunless -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Produkty (emoji)",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Kotwica (#)", "default": "produkty" },
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "WYBIERZ SWOJE" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Produkty" },
    { "type": "text", "id": "more_label", "label": "Przycisk do strony produktu", "default": "Szczegóły" }
  ],
  "blocks": [
    { "type": "product", "name": "Produkt", "settings": [
      { "type": "product", "id": "product", "label": "Produkt" },
      { "type": "text", "id": "emoji", "label": "Emoji", "default": "🥷" },
      { "type": "text", "id": "label", "label": "Krótka nazwa", "default": "Kominiarka" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Produkty (emoji)", "blocks": [
    { "type": "product", "settings": { "emoji": "🥷", "label": "Kominiarka" } },
    { "type": "product", "settings": { "emoji": "🏴", "label": "Flaga" } },
    { "type": "product", "settings": { "emoji": "🦇", "label": "Naklejka" } }
  ] }]
}
{% endschema %}
