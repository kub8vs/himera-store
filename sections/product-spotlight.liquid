{%- comment -%} "Produkty": three emoji tabs (🥷 🏴 🦇), below them the picked product with its description and the buy form. {%- endcomment -%}
<section class="spot" id="{{ section.settings.anchor | default: 'produkty' }}" data-spot>
  <div class="spot__glow" aria-hidden="true"></div>
  <div class="wrap spot__head">
    <span class="mono spot__kicker" data-reveal>{{ section.settings.kicker }}</span>
    <h2 class="spot__h" data-reveal>{{ section.settings.heading }}</h2>
    <div class="spot__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}" data-reveal>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <button class="spot__tab{% if forloop.first %} is-on{% endif %}" type="button" role="tab" id="spot-tab-{{ block.id }}" aria-controls="spot-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-spot-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="spot__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
            <span class="mono spot__lab">{{ block.settings.label | default: p.title }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="wrap spot__panels">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank -%}
        {%- liquid
          assign img = p.metafields.custom.showcase_image.value | default: p.featured_image
          assign code = p.metafields.custom.code.value | default: p.type
          assign variant = p.selected_or_first_available_variant
        -%}
        <article class="spot__panel{% if forloop.first %} is-on{% endif %}" id="spot-{{ block.id }}" role="tabpanel" aria-labelledby="spot-tab-{{ block.id }}" data-spot-panel>
          <a class="spot__stage" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
            <i class="spot__halo" aria-hidden="true"></i>
            <span class="spot__float">{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', alt: p.title, width: 1200, height: 1200 }}</span>
            <i class="spot__floor" aria-hidden="true"></i>
          </a>
          <div class="spot__info">
            <span class="mono spot__code">{{ code }}</span>
            <h3 class="spot__title">{{ p.title }}</h3>
            {% render 'price', product: p %}
            <div class="spot__desc rte">{{ p.description }}</div>

            {%- form 'product', p, class: 'spot__form', data-type: 'add' -%}
              {%- unless p.has_only_default_variant -%}
                <label class="mono spot__label" for="spot-var-{{ block.id }}">{{ p.options.first }}</label>
                <select id="spot-var-{{ block.id }}" name="id" class="pdp__select">
                  {%- for v in p.variants -%}<option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money }}</option>{%- endfor -%}
                </select>
              {%- else -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
              {%- endunless -%}
              <input type="hidden" name="quantity" value="1">
              <div class="spot__buy">
                {%- if p.available -%}
                  <button class="btn btn--bone" type="submit" data-add data-title="{{ p.title | escape }}" data-price="{{ p.price }}" data-url="{{ p.url }}" data-img="{{ p.featured_image | image_url: width: 300 }}">{{ 'products.add_to_cart' | t }}{% render 'icon-arrow' %}</button>
                {%- else -%}
                  <span class="btn btn--off" aria-disabled="true">{{ 'products.sold_out' | t }}</span>
                {%- endif -%}
                <a class="btn btn--line" href="{{ p.url }}">{{ section.settings.more_label }}{% render 'icon-arrow' %}</a>
              </div>
            {%- endform -%}
            {%- unless p.available -%}
              <a class="spot__notify mono" href="#dolacz">{{ 'products.notify' | t }} <span aria-hidden="true">↗</span></a>
            {%- endunless -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Produkty (emoji)",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Kotwica (#)", "default": "produkty" },
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "WYBIERZ SWOJE" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Produkty" },
    { "type": "text", "id": "more_label", "label": "Przycisk do strony produktu", "default": "Szczegóły" }
  ],
  "blocks": [
    { "type": "product", "name": "Produkt", "settings": [
      { "type": "product", "id": "product", "label": "Produkt" },
      { "type": "text", "id": "emoji", "label": "Emoji", "default": "🥷" },
      { "type": "text", "id": "label", "label": "Krótka nazwa", "default": "Kominiarka" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Produkty (emoji)", "blocks": [
    { "type": "product", "settings": { "emoji": "🥷", "label": "Kominiarka" } },
    { "type": "product", "settings": { "emoji": "🏴", "label": "Flaga" } },
    { "type": "product", "settings": { "emoji": "🦇", "label": "Naklejka" } }
  ] }]
}
{% endschema %}
