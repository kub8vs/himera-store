{%- liquid
  assign left = linklists[section.settings.menu_left]
  assign right = linklists[section.settings.menu_right]
-%}
<header class="hdr" data-header>
  <div class="hdr__corner">
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu-drawer" aria-label="{{ 'general.menu' | t }}" data-menu-open>
      <i></i><i></i>
    </button>
    {%- if settings.instagram_url != blank -%}<a class="hdr__social" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">IG</a>{%- endif -%}
    {%- if settings.youtube_url != blank -%}<a class="hdr__social" href="{{ settings.youtube_url }}" target="_blank" rel="noopener">YT</a>{%- endif -%}
  </div>

  <nav class="hdr__nav hdr__nav--l" aria-label="Menu">
    {%- for link in left.links -%}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a>
    {%- endfor -%}
  </nav>

  <a class="hdr__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {%- if settings.logo -%}
      {{ settings.logo | image_url: width: 240 | image_tag: alt: shop.name, width: settings.logo_width }}
    {%- else -%}
      <img src="{{ 'himera-logo.webp' | asset_url }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | times: 0.83 | round }}">
    {%- endif -%}
    <i class="hdr__glint" aria-hidden="true"></i><i class="hdr__glint hdr__glint--r" aria-hidden="true"></i>
  </a>

  <nav class="hdr__nav hdr__nav--r" aria-label="Menu">
    {%- for link in right.links -%}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a>
    {%- endfor -%}
  </nav>

  <div class="hdr__corner hdr__corner--r">
    {%- if shop.customer_accounts_enabled or preview -%}
      {%- if customer -%}
        <a class="hdr__icon" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'user' %}<span class="hdr__label">{{ 'general.account' | t }}</span></a>
      {%- else -%}
        <a class="hdr__icon" href="{{ routes.account_login_url }}" aria-label="{{ 'general.login' | t }}">{% render 'icon', name: 'user' %}<span class="hdr__label">{{ 'general.login' | t }}</span></a>
      {%- endif -%}
    {%- endif -%}
    <a class="hdr__icon hdr__cart" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">{% render 'icon', name: 'bag' %}<span class="hdr__label">{{ 'general.cart' | t }}</span><span class="hdr__count" data-cart-count>{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span></a>
  </div>
</header>

<div class="drawer" id="menu-drawer" hidden data-menu>
  <div class="drawer__inner">
    <div class="drawer__top">
      <img class="drawer__logo" src="{% if settings.logo %}{{ settings.logo | image_url: width: 160 }}{% else %}{{ 'himera-logo.webp' | asset_url }}{% endif %}" alt="" width="54" height="45">
      <button class="drawer__close" type="button" data-menu-close aria-label="{{ 'general.close' | t }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg></button>
    </div>
    <nav class="drawer__nav" aria-label="Menu główne">
      <ol class="drawer__list">
        {%- assign n = 0 -%}
        {%- for link in left.links -%}{%- assign n = n | plus: 1 -%}<li style="--i: {{ n }}"><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span class="mono">0{{ n }}</span>{{ link.title }}</a></li>{%- endfor -%}
        {%- for link in right.links -%}{%- assign n = n | plus: 1 -%}<li style="--i: {{ n }}"><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span class="mono">0{{ n }}</span>{{ link.title }}</a></li>{%- endfor -%}
      </ol>
    </nav>
    <div class="drawer__foot">
      <div class="drawer__pills">
        <a class="drawer__pill mono" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{% render 'icon', name: 'user' %}{% if customer %}Konto{% else %}{{ 'general.login' | t }}{% endif %}</a>
        <a class="drawer__pill drawer__pill--cart mono" href="{{ routes.cart_url }}">{% render 'icon', name: 'bag' %}{{ 'general.cart' | t }}<b data-cart-count>{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</b></a>
      </div>
      <div class="drawer__meta mono">
        {%- if settings.announcement != blank -%}<span><i></i>{{ settings.announcement }}</span>{%- endif -%}
        <span>{%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}{%- if settings.instagram_url != blank and settings.youtube_url != blank %} · {% endif -%}{%- if settings.youtube_url != blank -%}<a href="{{ settings.youtube_url }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nagłówek",
  "settings": [
    { "type": "link_list", "id": "menu_left", "label": "Menu po lewej od logo", "default": "main-menu" },
    { "type": "link_list", "id": "menu_right", "label": "Menu po prawej od logo", "default": "main-menu-right" }
  ]
}
{% endschema %}
